## CMS Configuration
## Copy this file to config.env and fill in your values before starting the stack.

## MySQL password for the CMS database user.
## Use a 16-character alphanumeric password (no special characters or spaces).
## Generate one at: https://www.random.org/passwords/?num=1&len=16&format=plain&rnd=new
MYSQL_PASSWORD=CHANGE_ME_16_CHAR_ALPHANUMERIC

## SMTP Server Configuration
CMS_SMTP_SERVER=smtp.gmail.com:587
CMS_SMTP_USERNAME=youraccount@gmail.com
CMS_SMTP_PASSWORD=yourpassword
CMS_SMTP_USE_TLS=YES
CMS_SMTP_USE_STARTTLS=YES
CMS_SMTP_REWRITE_DOMAIN=gmail.com
CMS_SMTP_HOSTNAME=gmail.com
CMS_SMTP_FROM_LINE_OVERRIDE=YES
# CMS_SMTP_FROM=myemail@example.org

## The DNS name or IP address users will use to reach the CMS.
CMS_SERVER_NAME=cms.example.org

## Sub-directory install — uncomment and set if not serving from web root.
# CMS_ALIAS=/xibo

## Increase upload limits for large media files if needed.
# CMS_PHP_POST_MAX_SIZE=4G
# CMS_PHP_UPLOAD_MAX_FILESIZE=4G
# CMS_PHP_MAX_EXECUTION_TIME=600

## QuickChart URL — leave commented to use the bundled cms-quickchart container.
# CMS_QUICK_CHART_URL=http://cms-quickchart:3400

## Disable the internal task runner if you run it externally.
# XTR_ENABLED=false
